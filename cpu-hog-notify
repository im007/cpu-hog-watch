# Script: cpu-hog-notify
# Purpose: Render the desktop popup for cpu-hog-watch and, if asked,
#          terminate the offending process safely.
#
# WHY THIS IS A SEPARATE SCRIPT
#   notify-send -A implies --wait: it blocks until the user clicks or
#   the popup expires. Calling that inline from the timer service would
#   hold the unit active for the whole popup lifetime and collide with
#   the next tick. The watcher launches this as a transient unit.
#
# Prerequisites: bash 4+, libnotify
#
# Usage: cpu-hog-notify hog PID START COMM PCT MINS TEMP KILLBUTTON
#        cpu-hog-notify thermal temp|fan VALUE SAMPLES
#
# Exit Codes:
#   0 - Success
#   2 - Invalid arguments
#   4 - Refused to kill (safety check failed)
#
set -uo pipefail

SCRIPT_NAME="$(basename "$0")"
readonly SCRIPT_NAME
readonly APP_NAME="CPU Hog Watch"

# Reverse-DNS application ID, and it has to be reverse-DNS.
#
# Icon lookup falls back by truncating at dashes, so the obvious name
# "cpu-hog-watch" is tried, then "cpu-hog", then "cpu" — and most icon themes
# ship a "cpu". Papirus does, so the notification silently showed a generic
# chip instead of this mark. Nothing was missing and nothing errored; the name
# resolved, just to somebody else's icon. An ID with no dash-truncated prefix
# in any theme cannot be shadowed that way.
readonly APP_ID="io.github.im007.cpu-hog-watch"

# Falls back to a stock freedesktop name when the mark is not installed, so a
# clone run straight from a checkout still shows an icon rather than none.
# Passed as a PATH, not as the app-id name. The header icon already comes from
# the .desktop entry via the hint below; when -i names that same icon the
# daemon shows only the header and drops the large image. A path keeps both:
# the mark in the header, and the mark again as the notification's own image.
_icon() {
    local d="${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor" c
    for c in "$d/scalable/apps/$APP_ID.svg" "$d/128x128/apps/$APP_ID.png"; do
        [ -r "$c" ] && { printf '%s' "$c"; return 0; }
    done
    printf 'utilities-system-monitor'
}
ICON="$(_icon)"
readonly ICON
# Binds the popup to the .desktop entry, which is what supplies the small icon
# in the notification header and keeps it once notifications are grouped.
readonly DESKTOP_HINT="string:desktop-entry:$APP_ID"
# Popups are resident (-t 0) so an alert cannot fade while you are
# away from the desk. This bounds the waiting helper, not the popup.
readonly POPUP_TIMEOUT=21600
# Below this share of one core, a "top consumer" is not worth
# offering to kill - it is just the desktop doing its job.
readonly KILL_OFFER_PCT=50

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
readonly SCRIPT_DIR
# shellcheck source=cpu-hog-lib.sh
if [ -r "$SCRIPT_DIR/cpu-hog-lib.sh" ]; then
    . "$SCRIPT_DIR/cpu-hog-lib.sh"
fi

_log() {
    printf '[%s] [%s] [%s] %s\n' \
        "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$1" "$SCRIPT_NAME" "${*:2}" >&2
}

# ==============================================================================
# Measurement
# ==============================================================================

# Same last-paren strip as the watcher: comm contains spaces and
# parens ("Isolated Web Co"), so naive field numbering reads garbage.
_stat_fields() {
    local raw
    raw="$(< "/proc/$1/stat")" 2>/dev/null || return 1
    printf '%s\n' "${raw##*') '}"
}

_starttime_of() {
    local rest; rest="$(_stat_fields "$1")" || return 1
    local IFS=' '; local -a f; read -ra f <<< "$rest"
    [ "${#f[@]}" -gt 19 ] || return 1
    printf '%s\n' "${f[19]}"
}

_ticks_of() {
    local rest; rest="$(_stat_fields "$1")" || return 1
    local IFS=' '; local -a f; read -ra f <<< "$rest"
    [ "${#f[@]}" -gt 12 ] || return 1
    printf '%s\n' "$(( ${f[11]} + ${f[12]} ))"
}

_total_jiffies() {
    local IFS=' '; local -a f
    read -ra f < /proc/stat
    local sum=0 i
    for i in "${f[@]:1}"; do sum=$(( sum + i )); done
    printf '%s\n' "$sum"
}

# Emit "<pct> <pid> <comm>" for the busiest processes, highest first.
#
# NOT `ps -eo pcpu`. That is a LIFETIME AVERAGE, so it under-reports a
# process that just started misbehaving - it showed a pegged browser
# tab as 78% when it was at 99.4%. Worse, it ranks ITSELF near 100%,
# because ps is the newest and briefest thing in its own snapshot,
# which is how "100 ps" ends up at the top of an alert.
_top_procs() {
    local want="${1:-3}" self=$$
    local -A t0
    local d pid ncpu tj0 tj1 elapsed delta pct comm
    ncpu="$(grep -c '^cpu[0-9]' /proc/stat)"
    [ "$ncpu" -ge 1 ] || ncpu=1

    tj0="$(_total_jiffies)"
    for d in /proc/[0-9]*; do
        pid="${d#/proc/}"
        [ "$pid" = "$self" ] && continue
        [ -O "$d" ] || continue
        t0[$pid]="$(_ticks_of "$pid")" 2>/dev/null || true
    done

    sleep 1

    tj1="$(_total_jiffies)"
    elapsed=$(( (tj1 - tj0) / ncpu ))
    [ "$elapsed" -gt 0 ] || elapsed=100

    for pid in "${!t0[@]}"; do
        [ -n "${t0[$pid]}" ] || continue
        delta="$(_ticks_of "$pid" 2>/dev/null)" || continue
        pct=$(( (delta - ${t0[$pid]}) * 100 / elapsed ))
        [ "$pct" -gt 0 ] || continue
        comm="$(cat "/proc/$pid/comm" 2>/dev/null)" || continue
        printf '%s %s %s\n' "$pct" "$pid" "$comm"
    done | sort -rn | head -n "$want"
}

# ==============================================================================
# Killing
# ==============================================================================

# True when the PID is gone for our purposes.
#
# A ZOMBIE COUNTS AS DEAD. It has already terminated and merely keeps
# a /proc entry until its parent reaps it - which may never happen on
# our timescale, and is not ours to wait for. Testing `[ -d /proc/PID ]`
# alone reports a successful kill as "survived SIGKILL".
_is_dead() {
    local st
    [ -e "/proc/$1/stat" ] || return 0
    st="$(_stat_fields "$1" 2>/dev/null | awk '{print $1}')" || return 0
    [ -z "$st" ] && return 0
    [ "$st" = "Z" ] && return 0
    return 1
}

# True if the PID is alive AND is still the same process instance.
_still_same() {
    _is_dead "$1" && return 1
    [ "$(_starttime_of "$1")" = "$2" ] || return 1
    return 0
}

# Every guard here matters: minutes can pass between the popup
# appearing and the click, and in that window the target may have
# exited and had its PID recycled onto something important.
_safe_kill() {
    local pid="$1" want_start="$2" comm="$3" now_start
    # Decided NOW, while the process still exists. The Chromium test reads
    # /proc/PID/cmdline, which is gone by the time the kill has succeeded, so
    # asking afterwards silently reports "not a tab" for every Chrome tab.
    local was_tab=false
    _is_browser_tab "$comm" "$pid" && was_tab=true

    if _is_dead "$pid"; then
        notify-send --app-name="$APP_NAME" -u low -i dialog-information \
            "Already gone" "$comm (PID $pid) exited on its own."
        _log INFO "pid $pid already gone"
        return 0
    fi

    now_start="$(_starttime_of "$pid")" || return 4
    if [ "$now_start" != "$want_start" ]; then
        notify-send --app-name="$APP_NAME" -u normal -i dialog-warning \
            "Nothing killed" \
            "PID $pid was recycled onto a different process."
        _log WARN "pid $pid starttime changed; refused"
        return 4
    fi

    if [ ! -O "/proc/$pid" ]; then
        notify-send --app-name="$APP_NAME" -u normal -i dialog-warning \
            "Nothing killed" "PID $pid is not owned by $USER."
        _log WARN "pid $pid not owned by $USER; refused"
        return 4
    fi

    # SIGTERM first. A Firefox content process dies cleanly on TERM and
    # the parent shows about:tabcrashed with a Restore button.
    _log INFO "sending SIGTERM to $pid ($comm)"
    kill -TERM "$pid" 2>/dev/null || true

    local _n
    for _n in 1 2 3 4 5 6; do
        sleep 0.5
        _is_dead "$pid" && break
    done
    unset _n

    if _still_same "$pid" "$want_start"; then
        _log WARN "pid $pid ignored SIGTERM, escalating to SIGKILL"
        kill -KILL "$pid" 2>/dev/null || true
        sleep 1
    fi

    if _still_same "$pid" "$want_start"; then
        notify-send --app-name="$APP_NAME" -u critical -i dialog-error \
            "Kill failed" "$comm (PID $pid) survived SIGKILL."
        _log ERROR "pid $pid survived SIGKILL"
        return 4
    fi

    # Only a browser TAB shows a Restore button. Saying it for every kill —
    # node, python, the browser itself — is the same false reassurance the
    # tab/parent split fixed above, in the message that reports success.
    local done_msg="PID $pid is gone."
    [ "$was_tab" = true ] && done_msg="$done_msg The tab shows a Restore button."
    notify-send --app-name="$APP_NAME" -u low -i dialog-information \
        "Stopped $comm" "$done_msg"
    _log INFO "pid $pid killed"
    return 0
}

# ==============================================================================
# Popups
# ==============================================================================

# Is this a browser CONTENT process — one tab — or the browser itself?
#
# Getting this backwards is not cosmetic. The popup promises the kill ends one
# tab, so matching the parent process makes it lie and closes the whole
# browser, losing every tab. The earlier matcher globbed *zen*, *firefox* and
# *chrome*, all of which match the parent: zen-bin, firefox and chrome are the
# comm values of the browsers themselves.
_is_browser_tab() {
    case "$1" in
        # Firefox family (Firefox, Zen, LibreWolf, Floorp). Content children
        # carry their own comm; the parent is firefox / zen-bin / librewolf.
        # Content processes only. WebExtensions hosts add-ons and
        # Isolated Servi* is a service worker — killing either is not
        # "this tab only", so they get no message rather than a wrong one.
        "Isolated Web Co"*|"Web Content"*|"Privileged Cont"*)
            return 0 ;;
    esac
    # Chromium family. Every process shares the comm "chrome", the parent
    # included, so only the command line distinguishes a renderer.
    case "$1" in
        chrome|chromium|chromium-browse|brave|msedge|vivaldi-bin|opera)
            case "$(tr '\0' ' ' < "/proc/$2/cmdline" 2>/dev/null)" in
                *--type=renderer*) return 0 ;;
            esac
            return 1 ;;
    esac
    return 1
}

# The browser itself. Killing this closes every tab, so say so plainly rather
# than offering the reassurance meant for a single content process.
_is_browser_parent() {
    case "$1" in
        firefox|zen|zen-bin|librewolf|floorp|waterfox|\
        chrome|chromium|chromium-browse|brave|msedge|vivaldi-bin|opera)
            return 0 ;;
    esac
    return 1
}

_do_hog() {
    local pid="$1" start="$2" comm="$3" pct="$4" mins="$5" temp="$6"
    local button="$7" title body action fan
    local -a args

    fan="$(_max_fan_rpm || echo '')"

    title="$comm · ${pct}% of a core"

    body="Held for <b>${mins} min</b> — PID ${pid}"
    if [ -n "$temp" ] && [ "$temp" != "0" ]; then
        body="$body"$'\n'"CPU ${temp} °C"
        [ -n "$fan" ] && body="$body · fan ${fan} RPM"
    fi
    # Kept to one line each, and parallel. The button already says what the
    # action is ("Stop it" vs "Close browser"), so the body only has to say
    # what the target is.
    if _is_browser_tab "$comm" "$pid"; then
        body="$body"$'\n\n'"Kills this browser tab only, browser keeps running."
    elif _is_browser_parent "$comm"; then
        body="$body"$'\n\n'"<b>Browser itself - this closes the entire browser.</b>"
    fi

    args=(--app-name="$APP_NAME" -u critical -t 0)
    args+=(-i "$ICON" --hint="$DESKTOP_HINT")

    if [ "$button" = "true" ]; then
        if _is_browser_parent "$comm"; then
            args+=(-A "kill=Close browser")
        else
            args+=(-A "kill=Stop it")
        fi
        args+=(-A "ignore=Leave it")
        action="$(timeout "$POPUP_TIMEOUT" \
            notify-send "${args[@]}" "$title" "$body" 2>/dev/null)" \
            || action=""
        [ "$action" = "kill" ] && _safe_kill "$pid" "$start" "$comm"
    else
        notify-send "${args[@]}" "$title" "$body" 2>/dev/null || true
    fi
}

_do_thermal() {
    local kind="$1" value="$2" samples="$3"
    local title body temp fan action top
    local tp tpid tcomm start
    local -a args

    temp="$(_cpu_temp_c || echo '')"
    fan="$(_max_fan_rpm || echo '')"

    if [ "$kind" = "temp" ]; then
        title="CPU holding at ${value} °C"
    else
        title="Fan pinned at ${value} RPM"
    fi

    if [ "$kind" = "temp" ]; then
        body="Sustained <b>~${samples} min</b>"
        [ -n "$fan" ] && body="$body · fan ${fan} RPM"
    else
        body="Sustained <b>~${samples} min</b>"
        [ -n "$temp" ] && body="$body · CPU ${temp} °C"
    fi

    top="$(_top_procs 3)"
    if [ -n "$top" ]; then
        body="$body"$'\n\n'"<b>Top CPU users</b>"
        while read -r tp tpid tcomm; do
            [ -n "$tp" ] || continue
            body="$body"$'\n'"${tp}%  ${tcomm}"
        done <<< "$top"
    fi

    read -r tp tpid tcomm <<< "$(printf '%s\n' "$top" | head -1)"

    args=(--app-name="$APP_NAME" -u normal -t 0 -i "$ICON"
      --hint="$DESKTOP_HINT")

    # Only offer a kill when one process is clearly to blame. A
    # thermal alert with no dominant process is informational: there
    # is nothing sensible to point a kill button at.
    if [ -n "${tp:-}" ] && [ "$tp" -ge "$KILL_OFFER_PCT" ] \
       && [ -d "/proc/$tpid" ]; then
        start="$(_starttime_of "$tpid")" || start=""
        if [ -n "$start" ]; then
            args+=(-A "kill=Stop $tcomm")
            args+=(-A "ignore=Leave it")
            action="$(timeout "$POPUP_TIMEOUT" \
                notify-send "${args[@]}" "$title" "$body" 2>/dev/null)" \
                || action=""
            [ "$action" = "kill" ] && _safe_kill "$tpid" "$start" "$tcomm"
            return 0
        fi
    fi

    notify-send "${args[@]}" "$title" "$body" 2>/dev/null || true
}

case "${1:-}" in
    hog)
        [ $# -eq 8 ] || { _log ERROR "hog: bad arg count"; exit 2; }
        _do_hog "$2" "$3" "$4" "$5" "$6" "$7" "$8"
        ;;
    thermal)
        [ $# -eq 4 ] || { _log ERROR "thermal: bad arg count"; exit 2; }
        _do_thermal "$2" "$3" "$4"
        ;;
    *)
        sed -n '/^# Script:/,/^$/p' "$0"; exit 2 ;;
esac
