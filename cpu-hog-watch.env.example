# cpu-hog-watch.env - install to ~/.config/cpu-hog-watch.env
#
# Every value here is optional; the script ships with these defaults.
# No secrets live in this file, so it is safe to commit a copy.

# Percent of ONE core that counts as "pegged". This machine has 16
# threads, so one saturated thread is only 6.25% system-wide - which
# is exactly why a system-wide monitor never catches it.
HOG_PCT=85

# Consecutive 60s samples above HOG_PCT before the popup fires.
# 10 = roughly ten minutes. Lower this and a normal page load or a
# short compile will start nagging you, which is how alerting dies.
HOG_STRIKES=10

# Processes allowed to peg a core without complaint. Extended regex,
# matched against comm AND full cmdline.
# NOTE: "claude" is deliberately absent - a Claude process holding a
# core for ten minutes is a thing worth knowing about.
#HOG_ALLOW_RE=cc1|rustc|ffmpeg|cargo|make|whisper|dnf|restic

# Thermal backstop - catches heat with no single process behind it
# (GPU, firmware, a root process the per-process watcher skips).
THERM_C=92
THERM_STRIKES=5
FAN_RPM=4500
FAN_STRIKES=15

# Which hwmon sensors carry package temperature and fan speed.
# Defaults suit AMD CPUs and the ChromeOS EC found in Framework
# laptops and Chromebooks. Run `sensors` to see what this host has:
#   Intel package temp -> THERM_HWMON=coretemp
#                         THERM_LABEL="Package id 0"
#   ThinkPad fans      -> FAN_HWMON=thinkpad
#   Dell fans          -> FAN_HWMON=dell_smm
# If neither sensor resolves, the thermal backstop cannot fire.
# `cpu-hog-watch --status` says so plainly, and so does
# `install.sh --verify`. The per-process watcher is unaffected.
THERM_HWMON=k10temp
THERM_LABEL=Tctl
FAN_HWMON=cros_ec

# Re-alert if the offender is STILL pegged this many samples after the
# last popup (~minutes at the 60s timer). Popups are resident and never
# fade on their own; this covers the case where you dismissed one and
# the process kept going. Raise it if a long job nags you.
HOG_RENOTIFY=30

# Show a "Kill it" button on the popup. Set false for notify-only.
HOG_KILL_BUTTON=true
